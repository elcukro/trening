{
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/exercises/:path*",
      "destination": "/exercises/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "trening-inky.vercel.app"
        }
      ],
      "destination": "https://trening.felsztukier.pl/",
      "permanent": true
    },
    {
      "source": "/:path([^.]+)",
      "has": [
        {
          "type": "host",
          "value": "trening-inky.vercel.app"
        }
      ],
      "destination": "https://trening.felsztukier.pl/:path",
      "permanent": true
    }
  ]
}
